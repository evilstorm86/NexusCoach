POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexuscoach

DATABASE_URL=postgresql+psycopg://nexus:change-me@db:5432/nexuscoach
JWT_SECRET=change-me
# Fernet key for user-stored secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Server-wide fallbacks. Users can override these per account on Profile → Settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://your-domain/integrations/withings/callback

# Public URL of the API as the browser sees it (baked into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Nightly sync. Hour is UTC. Set RUN_SCHEDULER=false on any extra replica.
RUN_SCHEDULER=true
NIGHTLY_HOUR=3
CLOUDFLARE_TUNNEL_TOKEN=
